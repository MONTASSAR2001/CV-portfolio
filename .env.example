# ── Supabase (Public — safe to expose in VITE_ prefix) ────────────────────────
# Readable by the browser. Do NOT store secrets here.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── AI & Deployment (Server-only — NO VITE_ prefix) ───────────────────────────
# These are read only by TanStack Start server functions (process.env.*).
# They are NEVER bundled into the client JS.
GROQ_API_KEY=your_groq_api_key
VERCEL_ACCESS_TOKEN=your_vercel_access_token
