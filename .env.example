# ── Supabase (Public — safe to expose via VITE_ prefix) ───────────────────────
# Readable by the browser. Do NOT store secrets here.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── AI Backend (Public — used by the browser to reach the Render backend) ─────
VITE_AI_BACKEND_URL=https://your-render-backend.onrender.com

# ── Server-only secrets (NO VITE_ prefix — never bundled into client JS) ──────
# Used by TanStack Start server functions (process.env.*) and the Express backend.

# NVIDIA NIM API key — powers AI CV extraction and portfolio generation
NVIDIA_API_KEY=your_nvidia_nim_api_key

# Stripe — required for checkout sessions and webhook verification
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# Supabase service role key — used by the /api/webhook route to update user tiers
# WARNING: This key bypasses Row Level Security. Keep it strictly server-side.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Vercel Access Token — required for deployPortfolioToVercel and publishPremiumPortfolio.
# Create one at: https://vercel.com/account/tokens  (scope: full account or specific team)
VERCEL_ACCESS_TOKEN=your_vercel_access_token
